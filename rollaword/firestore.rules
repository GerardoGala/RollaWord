rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only you, signed in with Google
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gerardogala1959@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /rollaword_leaderboard/{entry} {
      allow read: if true;

      // Players (and the game) can add scores, same checks as before
      allow create: if (
        request.resource.data.keys().hasAll(['name', 'date', 'score'])
        && request.resource.data.keys().hasOnly(['name', 'date', 'score', 'playerId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{8}$')
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && (!('playerId' in request.resource.data)
            || (request.resource.data.playerId is string
                && request.resource.data.playerId.size() <= 64))
      ) || isAdmin();

      // Only you can edit or delete
      allow update, delete: if isAdmin();
    }

    // Sailing simulator leaderboard: still fully locked
    match /leaderboard/{document=**} {
      allow read, write: if false;
    }
  }
}
